# Dependencies
node_modules/
**/package-lock.json
!/package-lock.json

# Environment files. Keep documented examples in version control.
.env
.env.*
!.env.example
!**/.env.example

# Operating-system files
.DS_Store

# Expo and React Native generated state
.expo/
dist/
web-build/

# Next.js generated state
.next/
out/

# TypeScript incremental build state
*.tsbuildinfo

# Test output
coverage/

# Supabase CLI local/link state. Migrations and functions remain tracked.
supabase/.temp/
supabase/.branches/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
