EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The Gemini key is deliberately absent: it lives only as a Supabase secret,
# read by the `ask-gemini` Edge Function (`supabase secrets set GEMINI_API_KEY=...`).
# Base URL of the Next.js app (apps/web) that hosts the shared /api/finance/search route.
# Production: your deployed web app's origin, e.g. https://budgetaiapp.com
# Local dev on a simulator: http://localhost:3000
# Local dev on a physical device / Expo Go: http://<your-machine-LAN-IP>:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
